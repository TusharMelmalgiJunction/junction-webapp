# Production build settings (committed). Local overrides go in .env.local, which is not committed
# and also applies to builds, so keep it free of localhost URLs when building for release.
VITE_API_BASE_URL=https://api.junctionverse.com

# Firebase Web app config for project junction-e0625. Leave empty to use the built-in key
# until a Web app is registered in the Firebase console (see deploy/DEPLOY.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
