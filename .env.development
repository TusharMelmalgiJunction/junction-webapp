# Dev server only (`npm run dev`). Requests go through the Vite proxy in vite.config.ts to
# https://api.junctionverse.com, so production CORS doesn't need to allow localhost.
# To use a local backend instead, put VITE_API_BASE_URL=http://localhost:3000 in .env.development.local
VITE_API_BASE_URL=/prod-api
